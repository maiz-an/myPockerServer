# Copy to .env (run.py does this for you on first start).
FILE_SERVER_PASSWORD=change-me-to-a-long-passphrase
FLASK_SECRET=generate-with-python-secrets.token_hex(32)-at-least-32-chars

# Optional
# SITE_NAME=Files
# PORT=8000
# AUTO_UPDATE=1          # set 0 to turn off automatic updates
# UPDATE_MINUTES=10      # how often to check for a new version
# CLOUDFLARE_TUNNEL_TOKEN=   # permanent link (named tunnel)
# PUBLIC_URL=                # shown when using a named tunnel
